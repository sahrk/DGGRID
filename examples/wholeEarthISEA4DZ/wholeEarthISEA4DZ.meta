################################################################################
#
# isea4d.meta - example of a DGGRID metafile that generates a resolution
#     4 ISEA4DSZ diamond grid.
#
# Kevin Sahr, 11/13/2026
#
################################################################################

# specify the operation
dggrid_operation GENERATE_GRID

# specify the DGG
dggs_type ISEA4DSZ
dggs_res_spec 4

# specify the output
cell_output_type KML
cell_output_file_name ./outputfiles/isea4dz
point_output_type KML
point_output_file_name ./outputfiles/isea4dzp
densification 3
