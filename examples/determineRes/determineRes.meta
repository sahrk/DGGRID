################################################################################
#
# determineRes.meta - example of a DGGRID metafile that chooses the resolution
#     of a mixed aperture ISEA43H grid from a target cell area of 120,000 km^2
#     and generates that grid for the whole earth.
#
# Kevin Sahr, 01/14/2013
#
################################################################################

# specify the operation
dggrid_operation GENERATE_GRID

# specify the DGG
dggs_type ISEA43H
dggs_num_aperture_4_res 2
# choose the resolution by cell area, rounding down to an available resolution
dggs_res_specify_type CELL_AREA
dggs_res_specify_area 120000.0
dggs_res_specify_rnd_down TRUE

# control the generation
clip_subset_type WHOLE_EARTH

# specify the output
cell_output_type KML
cell_output_file_name outputfiles/earth120k
densification 1
precision 6
