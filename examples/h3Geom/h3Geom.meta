################################################################################
#
# h3Geom.meta - example of a DGGRID metafile that generates the H3 grid
#     cells at H3 resolution 2 (DGGRID resolution 4) for a region in the
#     Norwegian Sea that contains a pentagon. The grid is specified explicitly,
#     so the H3 library is not required; cells are labeled with sequence
#     numbers. Output is in GeoJSON format.
#
# Kevin Sahr, 10/21/2026
#
################################################################################

# specify the operation
dggrid_operation GENERATE_GRID

# specify the DGG
dggs_type CUSTOM
dggs_topology HEXAGON
dggs_proj GNOMONIC
dggs_aperture_type SEQUENCE
dggs_aperture_sequence 437777777777777777
dggs_orient_preset DYMAXION
dggs_res_spec 4

# control the generation
clip_subset_type AIGEN
clip_region_files inputfiles/region.gen
geodetic_densify 0.0

# specify the output
output_cell_label_type GLOBAL_SEQUENCE
cell_output_type GEOJSON
cell_output_file_name outputfiles/h3res2
point_output_type GEOJSON
point_output_file_name outputfiles/h3res2p
densification 3
precision 7
