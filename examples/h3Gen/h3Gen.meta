################################################################################
#
# h3Gen.meta - example of a DGGRID metafile that generates the H3 grid at
#     H3 resolution 3 for a region in the Norwegian Sea that contains a
#     pentagon, labeled with H3 INT64 indexes, with the indexing parent and
#     children of each cell. Requires DGGRID built with the H3 library.
#
# For dggs_type H3, dggs_res_spec is the H3 resolution (0 - 15); the DGGRID
# resolution is two greater. See also h3GenString.meta and h3GenCustom.meta.
#
# Kevin Sahr, 10/21/2026
#
################################################################################

# specify the operation
dggrid_operation GENERATE_GRID

# specify the DGG
dggs_type H3
dggs_res_spec 3

# control the generation
clip_subset_type AIGEN
clip_region_files inputfiles/region.gen
geodetic_densify 0.0

# specify the output
# dggs_type H3 has H3 INT64 for input and output
cell_output_type GEOJSON
cell_output_file_name outputfiles/h3res3
point_output_type TEXT
point_output_file_name outputfiles/h3res3p
indexing_parent_output_type TEXT
indexing_parent_output_file_name outputfiles/h3res3
indexing_children_output_type TEXT
indexing_children_output_file_name outputfiles/h3res3
densification 3
precision 7
