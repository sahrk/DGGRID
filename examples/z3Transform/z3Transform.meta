################################################################################
#
# z3Transform.meta - example of a DGGRID metafile which performs address
#                   conversion from SEQNUM to Z3 indexes
#
# Note that the inputfiles directory contains GEO, Z3 INT64 (z3d0.txt and
# z3d3.txt), Z3 DIGIT_STRING (z3Str.txt), and SEQNUM files, all describing the
# same set of cells. You can experiment with transforming between these by
# changing the input_* and output_* parameters.
#
# z3d0.txt uses a padding digit of 0 (DGGRID version 8.x and earlier).
# z3d3.txt uses a padding digit of 3, the default as of DGGRID version 9.0.
# Use parameter z3_invalid_digit to set the appropriate padding digit.
#
# Kevin Sahr, 09/03/2019
#
################################################################################

# specify the operation
dggrid_operation TRANSFORM_POINTS

# specify the DGG
dggs_type ISEA3H
dggs_res_spec 9

# specify the input
input_address_type SEQNUM
input_file_name inputfiles/seqNum.txt
input_delimiter " "

# specify the output
output_address_type HIERNDX
output_hier_ndx_system Z3
output_hier_ndx_form INT64
z3_invalid_digit 3
output_file_name outputfiles/z3d3.txt
output_delimiter " "
