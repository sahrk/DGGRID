################################################################################
#
# wholeEarthIGEO7.meta - example of generating a whole earth IGEO7 DGG res 3.
#     IGEO7 is an alias for the ellipsoidal IGEO7v2 preset.
#
# Kevin Sahr, 04/01/2023
#
################################################################################

# specify the operation
dggrid_operation GENERATE_GRID

# specify the DGG
dggs_type IGEO7
dggs_res_spec 3

# specify the output
# IGEO7 DGGS preset has Z7 INT64 for input and output
cell_output_type KML
cell_output_file_name outputfiles/igeo7cells
point_output_type KML
point_output_file_name outputfiles/igeo7pts
densification 0
precision 6
kml_default_color ffff0000
kml_name IGEO7 Res 3
kml_description www.discreteglobalgrids.org
kml_default_width 3
