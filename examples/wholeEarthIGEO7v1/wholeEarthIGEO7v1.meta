################################################################################
# wholeEarthIGEO7v1.meta - example of generating a whole earth IGEO7v1 DGG res 3.
#     IGEO7v1 is the spherical ISEA IGEO7 of version 8.4.
#
################################################################################

# specify the operation
dggrid_operation GENERATE_GRID

# specify the DGG
dggs_type IGEO7v1
dggs_res_spec 3

# specify the output
# IGEO7v1 DGGS preset has Z7 INT64 for input and output
cell_output_type KML
cell_output_file_name outputfiles/igeo7v1cells
point_output_type KML
point_output_file_name outputfiles/igeo7v1pts
densification 0
precision 6
kml_default_color ff00ff00
kml_name IGEO7v1 Res 3
kml_description www.discreteglobalgrids.org
kml_default_width 3

