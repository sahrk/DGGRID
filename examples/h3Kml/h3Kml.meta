################################################################################
#
# h3Kml.meta - generate H3 resolution 3 cell boundaries and cell center
#     points for a region in the Norwegian Sea. Both outputs are KML files.
#     Requires DGGRID built with the H3 library.
#
################################################################################

dggrid_operation GENERATE_GRID

# dggs_res_spec is the H3 resolution when dggs_type is H3.
dggs_type H3
dggs_res_spec 3

clip_subset_type AIGEN
clip_region_files inputfiles/region.gen
geodetic_densify 0.0

# The H3 preset labels cells with H3 indexes and uses H3 boundaries.
cell_output_type KML
cell_output_file_name outputfiles/h3res3
point_output_type KML
point_output_file_name outputfiles/h3res3p
kml_default_width 2
kml_default_color ff0000ff
precision 7
