################################################################################
#
# h3Kml.meta - generate the H3 resolution 2 cell boundaries and cell center
#     points for the whole earth. Both outputs are KML files.
#     Requires DGGRID built with the H3 library.
#
################################################################################

dggrid_operation GENERATE_GRID

# dggs_res_spec is the H3 resolution when dggs_type is H3.
dggs_type H3
dggs_res_spec 2

clip_subset_type WHOLE_EARTH

# The H3 preset labels cells with H3 indexes and uses H3 boundaries.
cell_output_type KML
cell_output_file_name outputfiles/h3res2
point_output_type KML
point_output_file_name outputfiles/h3res2p
kml_default_width 2
kml_default_color ff0000ff
precision 7
