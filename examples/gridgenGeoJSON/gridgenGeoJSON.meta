################################################################################
#
# gridgenGeoJSON.meta - example of a DGGRID metafile that generates a resolution 16
#     mixed aperture ISEA43H grid (the first 6 resolutions are aperture 4) clipped
#     to a small area in Corvallis, Oregon. The output grid is in GeoJSON format.
#
# Matt Gregory, 11/04/2013
#
################################################################################

# specify the operation
dggrid_operation GENERATE_GRID

# specify the DGG
dggs_type ISEA43H
dggs_num_aperture_4_res 6
dggs_res_spec 16

# control the generation
clip_subset_type SHAPEFILE
clip_region_files inputfiles/corvallis
geodetic_densify 0.0

# specify the output
cell_output_type GEOJSON
cell_output_file_name outputfiles/corvallis_cell
point_output_type GEOJSON
point_output_file_name outputfiles/corvallis_point
densification 3
