# Doxyfile for ReadTheDocs / Breathe integration
#
# This file is separate from src/Doxyfile (the CMake-based upstream build).
# It is intentionally standalone with relative paths and produces XML output
# for Breathe/Sphinx plus browsable HTML. Run it from the repository root:
#   doxygen documentation/Doxyfile

PROJECT_NAME           = DGGRID
PROJECT_BRIEF          = "Discrete Global Grid System software"

# Input: the core libraries (paths relative to the repository root)
INPUT                  = src/lib
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp
# third-party code and unused old sources
EXCLUDE                = src/lib/shapelib src/lib/proj4lib src/lib/dglib/lib/OLDSYS

# XML output for Breathe/Sphinx, HTML for GitHub Pages
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
OUTPUT_DIRECTORY       = documentation/build/doxygen
XML_OUTPUT             = xml
HTML_OUTPUT            = html

# Class and collaboration diagrams via Graphviz
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

# Suppress noise
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO

# Rewrites C++11 "friend X;" for Breathe, see doxygen_filter.py
FILTER_PATTERNS        = "*.h=python3 documentation/doxygen_filter.py"
# Anonymous namespaces (doxygen names them @N) crash Breathe 4.36 doxygenindex
EXCLUDE_SYMBOLS        = @*
